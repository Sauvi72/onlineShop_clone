# Port to listen on (Render provides PORT automatically)
PORT=3000

# Optional: MongoDB connection string (e.g. MongoDB Atlas)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fullstack_db?retryWrites=true&w=majority

# Optional: CORS allowed origins (comma-separated, e.g. https://your-frontend.vercel.app)
# If left empty, all origins are allowed (*)
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
